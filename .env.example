# Bien tuy chon. Copy thanh .env neu can doi mac dinh.
# Khong ghi token, mat khau, hay API key vao day.
# Bien da co trong moi truong tien trinh duoc giu, .env khong ghi de.

# Thu muc log. Mac dinh: logs/
# SETUP_LOG_DIR=logs

# Doi so them cho moi lenh `choco install`. Mac dinh trong runner: --no-progress
# CHOCO_EXTRA_ARGS=--no-progress

# Dat 1 de khong dung `pause` cuoi script (agent hoac goi tu script khac).
# SETUP_NO_PAUSE=1
